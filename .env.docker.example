APP_NAME=Jongerenkaart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
VIEW_COMPILED_PATH=/var/www/html/storage/framework/views

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongodb:27017/jongerenkaart
MONGODB_DATABASE=jongerenkaart

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local-development-key

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ABSOLUTE_LIFETIME=60

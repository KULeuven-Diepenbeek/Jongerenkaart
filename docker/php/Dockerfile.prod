FROM composer:2 AS composer
FROM node:22-bookworm-slim AS assets
FROM php:8.4-fpm-bookworm AS php-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        ca-certificates \
        libicu-dev \
        libpng-dev \
        libzip-dev \
        unzip \
        zip \
    && docker-php-ext-configure intl \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        exif \
        intl \
        opcache \
        pcntl \
        zip \
    && pecl install mongodb \
    && docker-php-ext-enable mongodb \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/php.ini /usr/local/etc/php/conf.d/99-jongerenkaart.ini
WORKDIR /var/www/html

FROM php-base AS vendor
WORKDIR /app
COPY --from=composer /usr/bin/composer /usr/bin/composer
COPY src/ ./
RUN if [ -f composer.json ]; then \
        composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader; \
    fi

FROM assets AS frontend
WORKDIR /app
COPY src/ ./
RUN if [ -f package.json ]; then \
        npm ci && npm run build; \
    fi

FROM php-base AS production
WORKDIR /var/www/html
COPY --from=vendor --chown=www-data:www-data /app /var/www/html
COPY --from=frontend --chown=www-data:www-data /app/public /var/www/html/public
COPY --from=frontend --chown=www-data:www-data /app/public /var/www/public-dist
COPY --chmod=755 docker/php/entrypoint.sh /usr/local/bin/docker-entrypoint

RUN mkdir -p storage bootstrap/cache /var/www/html/public \
    && chown -R www-data:www-data storage bootstrap/cache /var/www/html/public /var/www/public-dist

ENTRYPOINT ["docker-entrypoint"]
CMD ["php-fpm"]
